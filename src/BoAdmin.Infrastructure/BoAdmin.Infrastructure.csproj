<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BoAdmin.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!--
    Sbox (HsmService) WCF proxy'si WSDL'den üretilir ve repoya konmaz. İki yoldan biri:
      - tools\generate-sbox-proxy.bat          -> Sbox\HsmServiceProxy.cs
      - VS: Infrastructure projesine sağ tık > Add > Connected Service > WCF Web Service,
            adı "Sbox", namespace "BoAdmin.Infrastructure.Sbox" -> Connected Services\Sbox\Reference.cs
    Dosya varsa SBOX_PROXY sembolü tanımlanır ve gerçek Sbox istemcisi derlenir.
  -->
  <PropertyGroup Condition="Exists('Sbox\HsmServiceProxy.cs') Or Exists('Connected Services\Sbox\Reference.cs')">
    <DefineConstants>$(DefineConstants);SBOX_PROXY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <!-- Sbox WCF istemcisi -->
    <PackageReference Include="System.ServiceModel.Http" Version="8.0.0" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoAdmin.Application\BoAdmin.Application.csproj" />
  </ItemGroup>

</Project>
