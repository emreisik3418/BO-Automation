@using BoAdmin.Web.Infrastructure
@using BoAdmin.Web.Modules.Reports.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["HideHeader"] = true;
    var env = Model.CurrentEnvironment;
    var stats = Model.Stats;
    var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
}

@* ---------------- Karşılama ---------------- *@
<section class="hero mb-4">
    <div class="hero-eyebrow">@DateTime.Now.ToString("d MMMM yyyy, dddd", tr)</div>
    <h1 class="hero-title">@Model.Greeting, @Model.FirstName</h1>
    <p class="hero-text">
        <strong>@env.DisplayName</strong> ortamında çalışıyorsunuz. Raporları arayabilir, CUID listesiyle toplu yedekleyip
        temizleyebilir ve yapılan her işlemin kaydını inceleyebilirsiniz.
    </p>
    <div class="hero-meta">
        <span class="hero-chip"><span class="env-dot bg-@env.Color"></span>@env.DisplayName (@env.Key)</span>
        <span class="hero-chip">@Icons.Get("user", 14) @Model.Sicil</span>
        <span class="hero-chip">@Icons.Get("shield", 14) Yetkili ortamlar: @string.Join(", ", Model.AccessibleEnvironments.Select(e => e.DisplayName))</span>
    </div>
</section>

@* ---------------- Özet ---------------- *@
@if (stats is not null)
{
    <div class="d-flex align-items-baseline justify-content-between mb-2">
        <h2 class="card-title-sm">Son @stats.PeriodDays gün &middot; @env.DisplayName</h2>
        <a asp-controller="Reports" asp-action="History" class="small text-decoration-none">Tüm geçmiş &rarr;</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <span class="stat-icon tone-brand">@Icons.Get("activity")</span>
                <div class="stat-label">Toplam işlem</div>
                <div class="stat-value">@stats.Total.ToString("N0", tr)</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <span class="stat-icon tone-success">@Icons.Get("check")</span>
                <div class="stat-label">Başarılı</div>
                <div class="stat-value">@stats.Success.ToString("N0", tr)</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <span class="stat-icon tone-danger">@Icons.Get("alert")</span>
                <div class="stat-label">Başarısız</div>
                <div class="stat-value">@stats.Failed.ToString("N0", tr)</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card">
                <span class="stat-icon tone-sky">@Icons.Get("copy")</span>
                <div class="stat-label">Yedeklenip silinen</div>
                <div class="stat-value">@stats.BackedUp.ToString("N0", tr)</div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    @* ---------------- Hızlı erişim ---------------- *@
    <div class="@(Model.HasReports ? "col-xl-7" : "col-12")">
        <h2 class="card-title-sm mb-2">Hızlı erişim</h2>
        <div class="row g-3">
            @if (Model.HasReports)
            {
                <div class="col-md-6">
                    <a class="action-card" asp-controller="Reports" asp-action="Index">
                        <span class="stat-icon tone-brand">@Icons.Get("search")</span>
                        <span>
                            <span class="action-title d-block">Rapor ara</span>
                            <span class="action-text d-block">Ad, klasör, sahip, tip ve tarihe göre filtreleyin; tekli veya çoklu silin.</span>
                        </span>
                        @Icons.Get("arrow-right", 18, "action-arrow")
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="action-card" asp-controller="Reports" asp-action="Bulk">
                        <span class="stat-icon tone-sky">@Icons.Get("layers")</span>
                        <span>
                            <span class="action-title d-block">Rapor silme</span>
                            <span class="action-text d-block">CUID listesi yükleyin; raporlar yedeklenip silinsin.</span>
                        </span>
                        @Icons.Get("arrow-right", 18, "action-arrow")
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="action-card" asp-controller="Reports" asp-action="Rename">
                        <span class="stat-icon tone-brand">@Icons.Get("edit")</span>
                        <span>
                            <span class="action-title d-block">Rapor adı güncelleme</span>
                            <span class="action-text d-block">Excel'deki CUID ve yeni ad listesiyle raporları toplu yeniden adlandırın.</span>
                        </span>
                        @Icons.Get("arrow-right", 18, "action-arrow")
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="action-card" asp-controller="Reports" asp-action="Keywords">
                        <span class="stat-icon tone-success">@Icons.Get("tag")</span>
                        <span>
                            <span class="action-title d-block">Keyword güncelleme</span>
                            <span class="action-text d-block">Excel'deki CUID listesiyle raporlara keyword ekleyin veya keyword'leri değiştirin.</span>
                        </span>
                        @Icons.Get("arrow-right", 18, "action-arrow")
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="action-card" asp-controller="Reports" asp-action="Index" asp-all-route-data="@ReportSearchViewModel.QuickFilter(lastDays: 7)">
                        <span class="stat-icon tone-success">@Icons.Get("calendar")</span>
                        <span>
                            <span class="action-title d-block">Son 7 günde değişenler</span>
                            <span class="action-text d-block">Yakın zamanda güncellenen raporlara tek tıkla bakın.</span>
                        </span>
                        @Icons.Get("arrow-right", 18, "action-arrow")
                    </a>
                </div>
                <div class="col-md-6">
                    <a class="action-card" asp-controller="Reports" asp-action="History">
                        <span class="stat-icon tone-muted">@Icons.Get("clock")</span>
                        <span>
                            <span class="action-title d-block">İşlem geçmişi</span>
                            <span class="action-text d-block">Kim, ne zaman, hangi raporu sildi; Excel'e aktarın.</span>
                        </span>
                        @Icons.Get("arrow-right", 18, "action-arrow")
                    </a>
                </div>
            }

            @foreach (var m in Model.ComingSoon)
            {
                <div class="col-md-6">
                    <div class="action-card is-disabled">
                        <span class="stat-icon tone-muted">@Icons.Get(m.Icon)</span>
                        <span>
                            <span class="action-title d-block">@m.Title <span class="kind-pill ms-1">Yakında</span></span>
                            <span class="action-text d-block">@m.Description</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ---------------- Son işlemler ---------------- *@
    @if (Model.HasReports)
    {
        <div class="col-xl-5">
            <h2 class="card-title-sm mb-2">Son işlemler</h2>
            <div class="card">
                @if (Model.RecentActivity.Count == 0)
                {
                    <div class="empty-state py-4">
                        <span class="empty-icon">@Icons.Get("activity", 26)</span>
                        <div class="empty-title">Henüz işlem yok</div>
                        <p class="empty-text mb-0">Bu ortamda son @(stats?.PeriodDays ?? 30) günde kayıtlı işlem bulunmuyor.</p>
                    </div>
                }
                else
                {
                    <ul class="activity-list">
                        @foreach (var e in Model.RecentActivity)
                        {
                            <li class="activity-item">
                                <span class="activity-dot @(e.Success ? "tone-success" : "tone-danger")">
                                    @Icons.Get(e.Success ? "check" : "x", 16)
                                </span>
                                <span class="activity-main">
                                    <span class="activity-title d-block" title="@e.ObjectName">@(e.ObjectName ?? $"ID {e.ObjectId}")</span>
                                    <span class="activity-meta d-block">@OperationNames.Get(e.Operation) &middot; @(e.DisplayName ?? e.UserName)</span>
                                </span>
                                <span class="activity-time">@HomeViewModel.TimeAgo(e.TimestampUtc)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>
