@using BoAdmin.Web.Infrastructure
@model ErrorViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Hata";
    ViewData["HideHeader"] = true;
    var is404 = Model?.StatusCode == 404;
}

<div class="card state-card">
    <div>
        <span class="state-icon @(is404 ? "tone-brand" : "tone-danger")">@Icons.Get(is404 ? "search" : "alert", 28)</span>
    </div>
    <h1 class="h4 fw-bold mb-2">@(Model?.Title ?? "Bir hata oluştu")</h1>
    <p class="text-muted mb-3">@(Model?.Message ?? "İşleminiz sırasında beklenmeyen bir hata oluştu.")</p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted mb-4">
            İz numarası: <code>@Model.RequestId</code><br />
            Sorun devam ederse bu numarayla sistem yöneticisine başvurun.
        </p>
    }

    <div class="d-flex justify-content-center gap-2">
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Geri dön</a>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana sayfa</a>
    </div>
</div>
