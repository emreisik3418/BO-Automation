@using BoAdmin.Web.Infrastructure
@using BoAdmin.Application.Principals
@model MembershipUploadViewModel
@{
    var isUser = Model.Type == MemberType.User;
    ViewData["Title"] = isUser ? "Grup Üyeliği" : "Alt Grup Ekleme";
    ViewData["Subtitle"] = isUser
        ? "Excel'deki listeyle kullanıcıları gruplara toplu ekleyin veya gruplardan çıkarın."
        : "Excel'deki listeyle gruplara alt grup ekleyin veya çıkarın.";
}

<div class="row g-4">
    <div class="col-xxl-7 col-xl-8">
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" asp-controller="@Model.Controller" asp-action="@Model.PreviewAction" enctype="multipart/form-data" class="card" data-busy-form>
            <div class="card-body">
                <label for="file" class="form-label">Excel dosyası (.xlsx)</label>
                <input type="file" class="form-control" id="file" name="file" accept=".xlsx,.xlsm" required />
                <div class="form-text mb-3">
                    İlk sayfa okunur:
                    @if (isUser)
                    {
                        <text><strong>Grup</strong>, <strong>Hesap</strong> ve <strong>İşlem</strong> (Ekle / Çıkar) sütunu.</text>
                    }
                    else
                    {
                        <text><strong>Üst Grup</strong>, <strong>Alt Grup</strong> ve <strong>İşlem</strong> (Ekle / Çıkar) sütunu.</text>
                    }
                    En fazla @MembershipChangeService.MaxBatchSize satır.
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary" data-busy-text="Dosya yükleniyor...">@Icons.Get("upload", 16) Önizle</button>
                    <a asp-controller="@Model.Controller" asp-action="MembersTemplate" class="btn btn-outline-success">@Icons.Get("download", 16) Boş şablonu indir</a>
                </div>
            </div>
        </form>
    </div>

    <div class="col-xxl-5 col-xl-4">
        <div class="card">
            <div class="card-header">Excel biçimi</div>
            <div class="card-body">
                <div class="table-wrap border rounded mb-3">
                    <table class="table table-modern mb-0">
                        <thead>
                            <tr>
                                <th>@(isUser ? "Grup" : "Üst Grup")</th>
                                <th>@(isUser ? "Hesap" : "Alt Grup")</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isUser)
                            {
                                <tr><td>Finans Raporlama</td><td>A12345</td><td><span class="kind-pill kind-Excel">Ekle</span></td></tr>
                                <tr><td>Satış Kullanıcıları</td><td>B67890</td><td><span class="kind-pill kind-Pdf">Çıkar</span></td></tr>
                            }
                            else
                            {
                                <tr><td>Tüm Raporlama</td><td>Finans Raporlama</td><td><span class="kind-pill kind-Excel">Ekle</span></td></tr>
                                <tr><td>Eski Projeler</td><td>Proje X</td><td><span class="kind-pill kind-Pdf">Çıkar</span></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Grup adları CMC'deki adla aynı olmalı (büyük/küçük harf fark etmez).</li>
                    <li>Zaten üye olan eklenmez, üye olmayan çıkarılmaz; önizlemede "atlanacak" görünür.</li>
                    <li>Her değişiklikten sonra üyelik BO'dan tekrar okunarak doğrulanır.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
