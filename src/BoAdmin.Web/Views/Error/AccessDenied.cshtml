@using BoAdmin.Web.Infrastructure
@inject ICurrentUser CurrentUser
@inject ICurrentEnvironment CurrentEnvironment
@{
    ViewData["Title"] = "Erişim Reddedildi";
    ViewData["HideHeader"] = true;
}

<div class="card state-card">
    <div>
        <span class="state-icon tone-danger">@Icons.Get("lock", 28)</span>
    </div>
    <h1 class="h4 fw-bold mb-2">Erişim reddedildi</h1>
    <p class="text-muted mb-4">
        Bu sayfaya <strong>@CurrentEnvironment.DisplayName</strong> ortamında erişim yetkiniz bulunmuyor.
    </p>

    @if (CurrentUser.IsAuthenticated)
    {
        <div class="summary-tile text-start mb-4">
            <div class="row small g-2">
                <div class="col-4 text-muted">Kullanıcı</div>
                <div class="col-8 fw-semibold">@CurrentUser.DisplayName</div>
                <div class="col-4 text-muted">Sicil</div>
                <div class="col-8 fw-semibold">@CurrentUser.Sicil</div>
                <div class="col-4 text-muted">Ortam</div>
                <div class="col-8 fw-semibold">@CurrentEnvironment.DisplayName (@CurrentEnvironment.Key)</div>
            </div>
        </div>
    }

    <p class="small text-muted">
        Yetki talebi için sicil numaranızla sistem yöneticinize başvurun. Başka bir ortamda yetkiniz varsa
        sol menünün altındaki <strong>Ortam</strong> seçiciden geçebilirsiniz.
    </p>

    <div class="d-flex justify-content-center gap-2">
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Geri dön</a>
    </div>
</div>
