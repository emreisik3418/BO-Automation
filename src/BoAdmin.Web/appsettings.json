{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\BoAdmin\\boadmin-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {UserName} {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "AuditDb": "Server=SQL_SUNUCU;Database=BoAdmin;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Authorization": {
    "Modules": {
      "Reports": {
        "AllowedUsers": [ "A12345" ],
        "AllowedGroups": [ "DOMAIN\\BO_Admins" ]
      },
      "Users": {
        "AllowedUsers": [],
        "AllowedGroups": []
      },
      "Groups": {
        "AllowedUsers": [],
        "AllowedGroups": []
      }
    }
  },

  "SapBo": {
    "BaseUrl": "http://bo-server:6405/biprws",
    "UserName": "svc_boadmin",
    "Password": "",
    "AuthType": "secEnterprise",
    "RequestTimeoutSeconds": 60,
    "TokenLifetimeMinutes": 50,
    "ArchiveFolderId": 0,
    "DeleteStrategy": "InfoObjects",
    "MoveStrategy": "InfoObjects",
    "QueryPageSize": 50
  },

  "AllowedHosts": "*"
}
