{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "D:\\Logs\\BoAdmin\\boadmin-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {UserName} {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Audit": {
    "Directory": "D:\\Logs\\BoAdmin\\audit"
  },

  "SapBo": {
    "DefaultEnvironment": "TEST",
    "RequestTimeoutSeconds": 60,
    "TokenLifetimeMinutes": 50,

    // Şirket şifre kasası. Bir ortamda "Sbox" bölümü varsa o ortamın BO kullanıcı/şifresi buradan alınır
    // (değer biçimi "kullanici;sifre"); UserName/Password kullanılmaz. Sbox şifresi buraya yazılmaz:
    // geliştirmede User Secrets (SapBo:Sbox:Password), sunucuda ortam değişkeni SapBo__Sbox__Password.
    "Sbox": {
      "Endpoint": "",
      "UserName": "",
      "Password": "",
      "TimeoutSeconds": 30,
      "CacheMinutes": 60
    },

    "Environments": {
      "TEST": {
        "DisplayName": "Test",
        "Color": "warning",
        "Order": 1,
        "IsCritical": false,
        "BaseUrl": "http://bo-test:6405/biprws",
        "UserName": "svc_boadmin",
        "Password": "",
        "AuthType": "secEnterprise",
        "RootFolderId": 23,
        "ArchiveFolderId": 0,
        "DeleteStrategy": "Documents",
        "MoveStrategy": "InfoObjects",
        "Authorization": {
          "Reports": {
            "AllowedUsers": [ "A12345" ],
            "AllowedGroups": [ "DOMAIN\\BO_Admins" ]
          },
          "Users": { "AllowedUsers": [], "AllowedGroups": [] },
          "Groups": { "AllowedUsers": [], "AllowedGroups": [] }
        }
      },

      "PROD": {
        "DisplayName": "Canlı",
        "Color": "danger",
        "Order": 2,
        "IsCritical": true,
        "BaseUrl": "http://bo-prod:6405/biprws",
        "UserName": "svc_boadmin",
        "Password": "",
        // Sbox kullanmak için doldurun (doluysa UserName/Password yok sayılır):
        // "Sbox": { "AppName": "...", "SubAppName": "...", "Ip": "...", "SensitiveDataName": "..." },
        "AuthType": "secEnterprise",
        "RootFolderId": 23,
        "ArchiveFolderId": 0,
        "DeleteStrategy": "Documents",
        "MoveStrategy": "InfoObjects",
        "Authorization": {
          "Reports": {
            "AllowedUsers": [],
            "AllowedGroups": [ "DOMAIN\\BO_Prod_Admins" ]
          },
          "Users": { "AllowedUsers": [], "AllowedGroups": [] },
          "Groups": { "AllowedUsers": [], "AllowedGroups": [] }
        }
      }
    }
  },

  "AllowedHosts": "*"
}
