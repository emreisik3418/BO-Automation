<?xml version="1.0" encoding="utf-8"?>
<!--
  Sunucuya kopyalanacak paket: Build > Publish > "Sunucu" profili > Publish.
  Çıktı: src\BoAdmin.Web\bin\publish\  (içindeki her şey sunucuya kopyalanır)
  Self-contained: sunucuda .NET kurulu olması gerekmez.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <PublishUrl>bin\publish\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- IIS kullanılmadığı için web.config üretme -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>
</Project>
