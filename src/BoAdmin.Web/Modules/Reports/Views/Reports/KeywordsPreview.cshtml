@using BoAdmin.Web.Infrastructure
@model KeywordPreviewViewModel
@inject CurrentEnvironmentAccessor CurrentEnvironment
@{
    ViewData["Title"] = "Keyword Önizleme";
    ViewData["Subtitle"] = "Aşağıdaki raporların keyword'leri güncellenecek. Kontrol edip onaylayın.";
    var p = Model.Preview;
    var toProcess = p.Processable;
    var skipped = p.Skipped;
    var problems = p.NotFound.Concat(p.InvalidRows).OrderBy(i => i.RowNumber).ToList();
    var addCount = toProcess.Count(i => i.Mode == KeywordMode.Add);
    var replaceCount = toProcess.Count - addCount;

    IEnumerable<string> Chips(string value) => KeywordList.Parse(value);
}

@* ---------------- Özet ---------------- *@
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Dosya</div>
            <div class="text-truncate fw-semibold" title="@Model.FileName">@Model.FileName</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Güncellenecek</div>
            <div class="summary-value">@toProcess.Count</div>
            <div class="small text-muted">@addCount ekleme · @replaceCount değiştirme</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Atlanan</div>
            <div class="summary-value">@skipped.Count</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Hatalı / bulunamayan</div>
            <div class="summary-value @(problems.Count > 0 ? "text-danger" : "")">@problems.Count</div>
        </div>
    </div>
</div>

@* ---------------- Sorunlu / atlanan satırlar ---------------- *@
@if (problems.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@problems.Count satır</strong> işleme alınmayacak.
        <details class="mt-1">
            <summary>Satırları göster</summary>
            <ul class="mb-0 mt-2 small">
                @foreach (var issue in problems.Take(200))
                {
                    <li>Satır @(issue.RowNumber)@(issue.Cuid is null ? "" : $" ({issue.Cuid})"): @issue.Reason</li>
                }
                @if (problems.Count > 200)
                {
                    <li>... ve @(problems.Count - 200) satır daha</li>
                }
            </ul>
        </details>
    </div>
}

@if (skipped.Count > 0)
{
    <div class="alert alert-light small">
        <strong>@skipped.Count rapor</strong> atlanacak.
        <details class="mt-1">
            <summary>Listeyi göster</summary>
            <ul class="mb-0 mt-2">
                @foreach (var item in skipped.Take(200))
                {
                    <li>Satır @(item.RowNumber) · @item.Report.Name: @item.Reason</li>
                }
            </ul>
        </details>
    </div>
}

@if (toProcess.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-icon">@Icons.Get("tag", 28)</span>
            <div class="empty-title">Güncellenecek rapor yok</div>
            <a asp-action="Keywords" class="btn btn-outline-secondary mt-2">Geri dön</a>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="toolbar">
            <span class="toolbar-title">Değişiklikler</span>
            <span class="toolbar-meta">@toProcess.Count rapor</span>
        </div>
        <div class="table-wrap preview-table">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Satır</th>
                        <th>Rapor</th>
                        <th>İşlem</th>
                        <th>Mevcut keyword'ler</th>
                        <th></th>
                        <th>Yeni keyword'ler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in toProcess)
                    {
                        var r = item.Report;
                        var current = new HashSet<string>(Chips(item.Current), StringComparer.CurrentCultureIgnoreCase);
                        var result = new HashSet<string>(Chips(item.Result), StringComparer.CurrentCultureIgnoreCase);
                        <tr>
                            <td class="cell-sub">@item.RowNumber</td>
                            <td>
                                <div class="cell-title">@r.Name</div>
                                <div class="cell-sub">@r.FolderPath</div>
                            </td>
                            <td>
                                <span class="kind-pill @(item.Mode == KeywordMode.Replace ? "kind-Pdf" : "kind-Excel")">@KeywordPreviewViewModel.ModeText(item.Mode)</span>
                            </td>
                            <td>
                                <div class="kw-list">
                                    @if (current.Count == 0)
                                    {
                                        <span class="cell-sub">(yok)</span>
                                    }
                                    @foreach (var k in Chips(item.Current))
                                    {
                                        <span class="kw-chip @(result.Contains(k) ? "" : "kw-removed")" title="@(result.Contains(k) ? "" : "Kaldırılacak")">@k</span>
                                    }
                                </div>
                            </td>
                            <td class="text-muted">@Icons.Get("arrow-right", 16)</td>
                            <td>
                                <div class="kw-list">
                                    @if (result.Count == 0)
                                    {
                                        <span class="cell-sub">(tümü silinecek)</span>
                                    }
                                    @foreach (var k in Chips(item.Result))
                                    {
                                        <span class="kw-chip @(current.Contains(k) ? "" : "kw-added")" title="@(current.Contains(k) ? "" : "Eklenecek")">@k</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <form method="post" asp-action="KeywordsExecute" id="bulkForm" class="card card-body"
          data-critical-env="@(CurrentEnvironment.IsCritical ? CurrentEnvironment.DisplayName : null)"
          data-confirm-text="@toProcess.Count raporun keyword'leri güncellenecek.">
        <input type="hidden" name="Environment" value="@(Model.EnvironmentKey ?? CurrentEnvironment.Key)" />
        <input type="hidden" name="PreviewJobId" value="@Model.PreviewJobId" />
        <input type="hidden" name="ConfirmationCount" value="@toProcess.Count" />

        <div class="alert @(CurrentEnvironment.IsCritical ? "alert-danger fw-semibold" : "alert-warning") small">
            <strong>@CurrentEnvironment.DisplayName</strong> ortamında @toProcess.Count raporun keyword'leri güncellenecek.
            "Ekle" satırlarında sonuç, işlem anındaki güncel keyword'lere göre yeniden hesaplanır.
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" id="confirmBtn">Onayla: keyword'leri güncelle</button>
            <a asp-action="Keywords" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
