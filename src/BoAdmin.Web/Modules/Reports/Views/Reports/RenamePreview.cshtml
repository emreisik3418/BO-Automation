@using BoAdmin.Web.Infrastructure
@model RenamePreviewViewModel
@inject CurrentEnvironmentAccessor CurrentEnvironment
@{
    ViewData["Title"] = "Ad Güncelleme Önizleme";
    ViewData["Subtitle"] = "Aşağıdaki raporların adı değiştirilecek. Kontrol edip onaylayın.";
    var p = Model.Preview;
    var toProcess = p.Processable;
    var skipped = p.Skipped;
    var problems = p.NotFound.Concat(p.InvalidRows).OrderBy(i => i.RowNumber).ToList();
}

@* ---------------- Özet ---------------- *@
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Dosya</div>
            <div class="text-truncate fw-semibold" title="@Model.FileName">@Model.FileName</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Güncellenecek</div>
            <div class="summary-value">@toProcess.Count</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Atlanan (aynı ad)</div>
            <div class="summary-value">@skipped.Count</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="summary-tile">
            <div class="summary-label">Hatalı / bulunamayan</div>
            <div class="summary-value @(problems.Count > 0 ? "text-danger" : "")">@problems.Count</div>
        </div>
    </div>
</div>

@* ---------------- Sorunlu satırlar ---------------- *@
@if (problems.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@problems.Count satır</strong> işleme alınmayacak.
        <details class="mt-1">
            <summary>Satırları göster</summary>
            <ul class="mb-0 mt-2 small">
                @foreach (var issue in problems.Take(200))
                {
                    <li>Satır @(issue.RowNumber)@(issue.Cuid is null ? "" : $" ({issue.Cuid})"): @issue.Reason</li>
                }
                @if (problems.Count > 200)
                {
                    <li>... ve @(problems.Count - 200) satır daha</li>
                }
            </ul>
        </details>
    </div>
}

@if (skipped.Count > 0)
{
    <div class="alert alert-light small">
        Yeni adı mevcut adıyla aynı olan @skipped.Count rapor atlanacak.
    </div>
}

@if (toProcess.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-icon">@Icons.Get("edit", 28)</span>
            <div class="empty-title">Güncellenecek rapor yok</div>
            <a asp-action="Rename" class="btn btn-outline-secondary mt-2">Geri dön</a>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="toolbar">
            <span class="toolbar-title">Değişiklikler</span>
            <span class="toolbar-meta">@toProcess.Count rapor</span>
        </div>
        <div class="table-wrap preview-table">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Satır</th>
                        <th>Mevcut ad</th>
                        <th></th>
                        <th>Yeni ad</th>
                        <th>Tip</th>
                        <th>ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in toProcess)
                    {
                        var r = item.Report;
                        <tr>
                            <td class="cell-sub">@item.RowNumber</td>
                            <td>
                                <div class="cell-title">@r.Name</div>
                                <div class="cell-sub">@r.FolderPath</div>
                            </td>
                            <td class="text-muted">@Icons.Get("arrow-right", 16)</td>
                            <td><div class="cell-title rename-new">@item.NewName</div></td>
                            <td><span class="kind-pill kind-@r.Kind">@r.KindDisplayName</span></td>
                            <td class="cell-sub">@r.Id</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <form method="post" asp-action="RenameExecute" id="bulkForm" class="card card-body">
        <input type="hidden" name="Environment" value="@(Model.EnvironmentKey ?? CurrentEnvironment.Key)" />
        <input type="hidden" name="PreviewJobId" value="@Model.PreviewJobId" />

        <div class="mb-3">
            <label for="confirmCount" class="form-label">
                Onaylamak için güncellenecek rapor sayısını yazın: <strong>@toProcess.Count</strong>
            </label>
            <input type="number" class="form-control w-auto" id="confirmCount" name="ConfirmationCount"
                   data-expected="@toProcess.Count" min="1" autocomplete="off" required />
        </div>

        <div class="alert @(CurrentEnvironment.IsCritical ? "alert-danger fw-semibold" : "alert-warning") small">
            <strong>@CurrentEnvironment.DisplayName</strong> ortamında @toProcess.Count raporun adı değiştirilecek.
            Raporun CUID'i, klasörü, instance'ları ve zamanlamaları değişmez.
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" id="confirmBtn" disabled>Onayla: adları güncelle</button>
            <a asp-action="Rename" class="btn btn-outline-secondary">Vazgeç</a>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
