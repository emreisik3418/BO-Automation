@using BoAdmin.Web.Infrastructure
@model DeletePreviewViewModel
@inject CurrentEnvironmentAccessor CurrentEnvironment
@{
    ViewData["Title"] = "Silme Önizleme";
    ViewData["Subtitle"] = "Aşağıdaki raporlar işlenecek. İşlem türünü seçip onaylayın.";
    var p = Model.Preview;
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (p.NotFoundIds.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@p.NotFoundIds.Count</strong> seçim BO'da bulunamadı veya desteklenen bir rapor türü değil; işleme alınmayacak.
        <span class="small">(ID: @string.Join(", ", p.NotFoundIds))</span>
    </div>
}

@if (p.Items.Count == 0)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-icon">@Icons.Get("reports", 28)</span>
            <div class="empty-title">İşlenecek rapor yok</div>
            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Rapor aramaya dön</a>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><div class="summary-tile"><div class="summary-label">Rapor</div><div class="summary-value">@p.Items.Count</div></div></div>
        <div class="col-6 col-md-3"><div class="summary-tile"><div class="summary-label">Instance</div><div class="summary-value">@p.TotalInstanceCount</div></div></div>
        <div class="col-12 col-md-6"><div class="summary-tile"><div class="summary-label">Ortam</div><div class="summary-value"><span class="env-dot bg-@CurrentEnvironment.Color me-2"></span>@CurrentEnvironment.DisplayName</div></div></div>
    </div>

    <div class="card mb-4">
        <div class="toolbar"><span class="toolbar-title">İşlenecek raporlar</span></div>
        <div class="table-wrap preview-table">
            <table class="table table-modern align-middle">
                <thead>
                    <tr>
                        <th>Rapor</th>
                        <th>Tip</th>
                        <th>Sahip</th>
                        <th>Son değişiklik</th>
                        <th class="text-end">Instance</th>
                        <th>ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in p.Items)
                    {
                        var r = item.Report;
                        <tr>
                            <td><div class="cell-title">@r.Name</div><div class="cell-sub">@r.FolderPath</div></td>
                            <td><span class="kind-pill kind-@r.Kind">@r.KindDisplayName</span></td>
                            <td>@r.Owner</td>
                            <td class="text-nowrap">@r.UpdatedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">@item.InstanceCount</td>
                            <td class="cell-sub">@r.Id</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <form method="post" asp-action="Delete" id="deleteForm" class="card"
          data-critical-env="@(CurrentEnvironment.IsCritical ? CurrentEnvironment.DisplayName : null)"
          data-confirm-text="@p.Items.Count rapor işlenecek. Kalıcı silme seçiliyse bu işlem geri alınamaz.">
        <div class="card-body">
            <input type="hidden" name="Environment" value="@CurrentEnvironment.Key" />
            @foreach (var item in p.Items)
            {
                <input type="hidden" name="SelectedIds" value="@item.Report.Id" />
            }

            <div class="form-label mb-2">İşlem türü</div>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="option-card" for="opDelete">
                        <input class="form-check-input" type="radio" name="MoveToArchive" id="opDelete" value="false" checked="@(!Model.MoveToArchive)" />
                        <span>
                            <span class="option-title d-block">Kalıcı olarak sil</span>
                            <span class="option-text d-block">Raporlar BO'dan silinir.</span>
                        </span>
                    </label>
                </div>
                <div class="col-md-6">
                    <label class="option-card" for="opArchive">
                        <input class="form-check-input" type="radio" name="MoveToArchive" id="opArchive" value="true"
                               checked="@(Model.MoveToArchive && p.IsArchiveAvailable)" disabled="@(!p.IsArchiveAvailable)" />
                        <span>
                            <span class="option-title d-block">Kurtarılabilir silme</span>
                            <span class="option-text d-block">
                                @(p.ArchiveFolder is not null ? $"Arşiv klasörüne taşınır: {p.ArchiveFolder.Path}" : "Bu ortamda arşiv klasörü tanımlı değil.")
                            </span>
                        </span>
                    </label>
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="DeleteInstances" id="deleteInstances" value="true"
                       checked="@Model.DeleteInstances" disabled="@(p.TotalInstanceCount == 0)" />
                <label class="form-check-label" for="deleteInstances">
                    Instance'ları (zamanlanmış çıktıları) da sil <span class="text-muted small">(@p.TotalInstanceCount adet)</span>
                </label>
            </div>

            <input type="hidden" name="ConfirmationCount" value="@p.Items.Count" />

            <div class="alert alert-warning small" id="deleteWarning">Kalıcı silme geri alınamaz.</div>
            @if (CurrentEnvironment.IsCritical)
            {
                <div class="alert alert-danger small fw-semibold">Dikkat: İşlem @CurrentEnvironment.DisplayName ortamında yapılacak.</div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger" id="confirmBtn">Onayla ve sil</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
