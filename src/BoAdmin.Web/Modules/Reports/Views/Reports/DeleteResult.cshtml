@using BoAdmin.Web.Infrastructure
@model DeleteResultViewModel
@inject CurrentEnvironmentAccessor CurrentEnvironment
@{
    ViewData["Title"] = Model.OperationText + " sonucu";
    var isBulk = Model.Operation == ReportOperation.BackupCopy;
    var isRename = Model.Operation == ReportOperation.Rename;
    var isKeywords = Model.Operation == ReportOperation.Keywords;
    var isDescription = Model.Operation == ReportOperation.Description;
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="stat-icon tone-success">@Icons.Get("check")</span>
            <div class="stat-label">Başarılı</div>
            <div class="stat-value">@Model.SuccessCount</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <span class="stat-icon @(Model.FailCount > 0 ? "tone-danger" : "tone-muted")">@Icons.Get("alert")</span>
            <div class="stat-label">Başarısız</div>
            <div class="stat-value">@Model.FailCount</div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="stat-card">
            <span class="stat-icon tone-brand">@Icons.Get("server")</span>
            <div class="stat-label">Ortam</div>
            <div class="stat-value fs-5"><span class="env-dot bg-@CurrentEnvironment.Color me-2"></span>@CurrentEnvironment.DisplayName</div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="toolbar"><span class="toolbar-title">Rapor bazında sonuç</span></div>
    <div class="table-wrap">
        <table class="table table-modern align-middle">
            <thead>
                <tr>
                    <th>Sonuç</th>
                    <th>Rapor</th>
                    <th>Mesaj</th>
                    <th>ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Results)
                {
                    <tr class="@(r.Success ? "" : "row-fail")">
                        <td>
                            <span class="status-pill @(r.Success ? "status-ok" : "status-fail")">@(r.Success ? "Başarılı" : "Başarısız")</span>
                        </td>
                        <td><div class="cell-title">@r.ReportName</div><div class="cell-sub">@r.FolderPath</div></td>
                        <td class="small">@r.Message</td>
                        <td class="cell-sub">@r.ReportId</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    @if (isBulk)
    {
        <a asp-action="Bulk" class="btn btn-primary">Yeni toplu işlem</a>
    }
    else if (isRename)
    {
        <a asp-action="Rename" class="btn btn-primary">Yeni ad güncelleme</a>
    }
    else if (isKeywords)
    {
        <a asp-action="Keywords" class="btn btn-primary">Yeni keyword güncelleme</a>
    }
    else if (isDescription)
    {
        <a asp-action="Descriptions" class="btn btn-primary">Yeni açıklama güncelleme</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-primary">Rapor aramaya dön</a>
    }
    <a asp-action="History" class="btn btn-outline-secondary">İşlem geçmişi</a>
</div>
