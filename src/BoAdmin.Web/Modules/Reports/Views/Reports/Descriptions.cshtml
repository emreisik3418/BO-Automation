@using BoAdmin.Web.Infrastructure
@model DescriptionUploadViewModel
@{
    ViewData["Title"] = "Açıklama Güncelleme";
    ViewData["Subtitle"] = "Excel'deki CUID ve yeni açıklama listesiyle rapor açıklamalarını toplu güncelleyin.";
}

<div class="row g-4">
    <div class="col-xxl-7 col-xl-8">
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post" asp-action="DescriptionsPreview" enctype="multipart/form-data" class="card" data-busy-form>
            <div class="card-body">
                <label for="file" class="form-label">Excel dosyası (.xlsx)</label>
                <input type="file" class="form-control" id="file" name="file"
                       accept=".xlsx,.xlsm,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                <div class="form-text mb-3">
                    İlk sayfa okunur: <strong>CUID</strong> ve <strong>Yeni Açıklama</strong> sütunu.
                    En fazla @Model.MaxCount rapor, 5 MB.
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary" data-busy-text="Dosya yükleniyor...">@Icons.Get("upload", 16) Önizle</button>
                    <a asp-action="DescriptionsTemplate" class="btn btn-outline-success">@Icons.Get("download", 16) Boş şablonu indir</a>
                </div>
            </div>
        </form>

        <div class="summary-tile mt-3">
            <div class="option-title mb-1"><span class="kind-pill kind-Pdf me-1">Değiştir</span></div>
            <div class="option-text">Raporun mevcut açıklaması tamamen Excel'deki metinle değiştirilir.
                Mevcut açıklamayla aynı olan satırlar atlanır.</div>
        </div>
    </div>

    <div class="col-xxl-5 col-xl-4">
        <div class="card">
            <div class="card-header">Excel biçimi</div>
            <div class="card-body">
                <div class="table-wrap border rounded mb-3">
                    <table class="table table-modern mb-0">
                        <thead>
                            <tr><th>CUID</th><th>Yeni Açıklama</th></tr>
                        </thead>
                        <tbody>
                            <tr><td class="mono">AW40QpsIInZGuxU7JobhPk0</td><td>Aylık finans özeti</td></tr>
                            <tr><td class="mono">AQ8aoL8XYyRC1X19n5gM9L8</td><td>Günlük hisse işlem raporu</td></tr>
                        </tbody>
                    </table>
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Hücre içinde Alt+Enter ile alt satıra geçebilirsiniz; satır sonları korunur.</li>
                    <li>Açıklama boş olamaz, en fazla @BoAdmin.Application.Reports.DescriptionText.MaxLength karakter.</li>
                    <li>Sütunlar başlıklarından bulunur. Başlık yoksa A = CUID, B = açıklama.</li>
                    <li>Önizlemede mevcut ve yeni açıklamayı görüp onaylamadan hiçbir rapor değiştirilmez.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
