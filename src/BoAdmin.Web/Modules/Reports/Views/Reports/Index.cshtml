@using BoAdmin.Web.Infrastructure
@model ReportSearchViewModel
@{
    ViewData["Title"] = "Rapor Arama";
    ViewData["Subtitle"] = "Raporları filtreleyin; tekli veya çoklu seçerek önizlemeli silme yapın.";
    var c = Model.Criteria;
}

@* ---------------- Filtreler ---------------- *@
<form method="get" asp-action="Index" class="card mb-4" id="searchForm">
    <input type="hidden" name="@ReportSearchViewModel.SearchFlag" value="1" />
    <input type="hidden" asp-for="Criteria.SortBy" />
    <input type="hidden" asp-for="Criteria.SortDescending" />

    <div class="card-body">
        <div class="filter-grid">
            <div>
                <label asp-for="Criteria.NameContains" class="form-label small mb-1">Rapor adı</label>
                <div class="input-icon">
                    @Icons.Get("search", 16)
                    <input asp-for="Criteria.NameContains" class="form-control" placeholder="Ad içerir..." autocomplete="off" />
                </div>
            </div>

            <div>
                <label for="folderSearch" class="form-label small mb-1">Klasör</label>
                <div class="autocomplete" data-folder-autocomplete data-url="@Url.Action("Folders")">
                    <div class="input-icon">
                        @Icons.Get("folder", 16)
                        <input type="text" id="folderSearch" class="form-control" placeholder="Klasör adı, yolu veya ID yazın..."
                               value="@Model.SelectedFolder?.Path" autocomplete="off" />
                    </div>
                    <input type="hidden" asp-for="Criteria.FolderId" data-folder-id />
                    <ul class="autocomplete-list" role="listbox" hidden></ul>
                </div>
            </div>

            <div>
                <label asp-for="Criteria.OwnerContains" class="form-label small mb-1">Sahip</label>
                <input asp-for="Criteria.OwnerContains" class="form-control" placeholder="İçerir..." autocomplete="off" />
            </div>

            <div>
                <label asp-for="Criteria.Kind" class="form-label small mb-1">Rapor tipi</label>
                <select asp-for="Criteria.Kind" class="form-select"
                        asp-items="@(new SelectList(Model.Kinds, nameof(ReportKindInfo.Kind), nameof(ReportKindInfo.DisplayName)))">
                    <option value="">Tümü</option>
                </select>
            </div>

            <div>
                <label class="form-label small mb-1">Son değişiklik</label>
                <div class="input-group">
                    <input asp-for="Criteria.UpdatedFrom" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" title="Başlangıç" />
                    <input asp-for="Criteria.UpdatedTo" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" title="Bitiş" />
                </div>
            </div>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary px-4">@Icons.Get("search", 16) Ara</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>

            <div class="form-check ms-2 mb-0">
                <input asp-for="Criteria.IncludeSubfolders" class="form-check-input" />
                <label asp-for="Criteria.IncludeSubfolders" class="form-check-label small">Alt klasörler dahil</label>
            </div>

            <div class="ms-auto d-flex align-items-center gap-2">
                <label asp-for="Criteria.PageSize" class="small text-muted mb-0">Sayfa başına</label>
                <select asp-for="Criteria.PageSize" class="form-select form-select-sm w-auto"
                        asp-items="@(new SelectList(ReportSearchViewModel.PageSizes))"></select>
            </div>
        </div>
    </div>
</form>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* ---------------- İlk açılış: hızlı filtreler ---------------- *@
@if (!Model.Searched)
{
    <div class="card">
        <div class="empty-state">
            <span class="empty-icon">@Icons.Get("search", 28)</span>
            <div class="empty-title">Aramaya başlayın</div>
            <p class="empty-text">
                Hızlı açılması için rapor listesi otomatik yüklenmez. Filtreleri doldurup <strong>Ara</strong>'ya basın
                ya da aşağıdaki hazır filtrelerden birini seçin.
            </p>
            <div class="chip-row">
                <a class="chip" asp-action="Index" asp-all-route-data="@ReportSearchViewModel.QuickFilter()">@Icons.Get("clock", 15) Son değişen 20 rapor</a>
                <a class="chip" asp-action="Index" asp-all-route-data="@ReportSearchViewModel.QuickFilter(lastDays: 7)">@Icons.Get("calendar", 15) Son 7 gün</a>
                <a class="chip" asp-action="Index" asp-all-route-data="@ReportSearchViewModel.QuickFilter(lastDays: 30)">@Icons.Get("calendar", 15) Son 30 gün</a>
                <a class="chip" asp-action="Index" asp-all-route-data="@ReportSearchViewModel.QuickFilter(kind: ReportKinds.Webi)">@Icons.Get("reports", 15) Web Intelligence</a>
                <a class="chip" asp-action="Index" asp-all-route-data="@ReportSearchViewModel.QuickFilter(kind: ReportKinds.Crystal)">@Icons.Get("reports", 15) Crystal Reports</a>
            </div>
        </div>
    </div>
}

@* ---------------- Sonuç tablosu ---------------- *@
@if (Model.Result is { } result)
{
    <form method="get" asp-action="DeletePreview" id="reportsForm" class="card">
        <div class="toolbar">
            <span class="toolbar-title">Sonuçlar</span>
            <span class="toolbar-meta">Sayfa @result.Page &middot; bu sayfada @result.Items.Count rapor</span>
            <button type="submit" class="btn btn-danger btn-sm ms-auto" id="bulkDeleteBtn" disabled>
                @Icons.Get("trash", 15) Seçilenleri sil (<span id="selectedCount">0</span>)
            </button>
        </div>

        <div class="table-wrap">
            <table class="table table-hover table-modern align-middle">
                <thead>
                    <tr>
                        <th style="width:2.5rem">
                            <input type="checkbox" class="form-check-input" id="selectAll" title="Sayfadakilerin tümünü seç" />
                        </th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Name)">Rapor<span class="sort-ind">@Model.SortIndicator(ReportSortField.Name)</span></a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Kind)">Tip<span class="sort-ind">@Model.SortIndicator(ReportSortField.Kind)</span></a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Owner)">Sahip<span class="sort-ind">@Model.SortIndicator(ReportSortField.Owner)</span></a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.UpdatedAt)">Son değişiklik<span class="sort-ind">@Model.SortIndicator(ReportSortField.UpdatedAt)</span></a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Id)">ID<span class="sort-ind">@Model.SortIndicator(ReportSortField.Id)</span></a></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (result.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state py-4">
                                    <div class="empty-title">Kriterlere uyan rapor bulunamadı</div>
                                    <p class="empty-text mb-0">Filtreleri genişletip tekrar deneyin.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in result.Items)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input row-check" name="selectedIds" value="@item.Id" />
                            </td>
                            <td>
                                <div class="cell-title">@item.Name</div>
                                <div class="cell-sub">@item.FolderPath</div>
                            </td>
                            <td><span class="kind-pill kind-@item.Kind">@item.KindDisplayName</span></td>
                            <td>@item.Owner</td>
                            <td class="text-nowrap">@item.UpdatedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="cell-sub">@item.Id</td>
                            <td class="text-end">
                                <a class="btn btn-outline-danger btn-sm" asp-action="DeletePreview" asp-route-selectedIds="@item.Id" title="Sil">
                                    @Icons.Get("trash", 15)
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pager">
            <span>Sayfa başına @c.PageSize kayıt</span>
            <ul class="pagination pagination-sm">
                <li class="page-item @(result.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValues(page: result.Page - 1)">&lsaquo; Önceki</a>
                </li>
                <li class="page-item active"><span class="page-link">@result.Page</span></li>
                <li class="page-item @(result.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValues(page: result.Page + 1)">Sonraki &rsaquo;</a>
                </li>
            </ul>
        </div>
    </form>
}

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
