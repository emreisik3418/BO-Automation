@model ReportSearchViewModel
@{
    ViewData["Title"] = "Rapor İşlemleri";
}

<partial name="_ReportsNav" model="@("Search")" />

@* ---------------- Filtreler ---------------- *@
<form method="get" asp-action="Index" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label asp-for="Criteria.NameContains" class="form-label small mb-1">Rapor adı</label>
            <input asp-for="Criteria.NameContains" class="form-control form-control-sm" placeholder="içerir..." />
        </div>

        <div class="col-lg-3 col-md-6">
            <label asp-for="Criteria.FolderId" class="form-label small mb-1">Klasör</label>
            <select asp-for="Criteria.FolderId" class="form-select form-select-sm"
                    asp-items="@(new SelectList(Model.Folders, nameof(FolderDto.Id), nameof(FolderDto.Path)))">
                <option value="">Tüm klasörler</option>
            </select>
            <div class="form-check form-check-inline mt-1">
                <input asp-for="Criteria.IncludeSubfolders" class="form-check-input" />
                <label asp-for="Criteria.IncludeSubfolders" class="form-check-label small">Alt klasörler dahil</label>
            </div>
        </div>

        <div class="col-lg-2 col-md-4">
            <label asp-for="Criteria.OwnerContains" class="form-label small mb-1">Sahip</label>
            <input asp-for="Criteria.OwnerContains" class="form-control form-control-sm" placeholder="içerir..." />
        </div>

        <div class="col-lg-2 col-md-4">
            <label asp-for="Criteria.Kind" class="form-label small mb-1">Rapor tipi</label>
            <select asp-for="Criteria.Kind" class="form-select form-select-sm"
                    asp-items="@(new SelectList(Model.Kinds, nameof(ReportKindInfo.Kind), nameof(ReportKindInfo.DisplayName)))">
                <option value="">Tümü</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-4">
            <label class="form-label small mb-1">Son değişiklik</label>
            <div class="input-group input-group-sm">
                <input asp-for="Criteria.UpdatedFrom" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" title="Başlangıç" />
                <input asp-for="Criteria.UpdatedTo" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" title="Bitiş" />
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
        <input type="hidden" asp-for="Criteria.SortBy" />
        <input type="hidden" asp-for="Criteria.SortDescending" />

        <button type="submit" class="btn btn-primary btn-sm px-3">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Temizle</a>

        <div class="ms-auto d-flex align-items-center gap-2">
            <label asp-for="Criteria.PageSize" class="small text-muted mb-0">Sayfa başına</label>
            <select asp-for="Criteria.PageSize" class="form-select form-select-sm w-auto"
                    asp-items="@(new SelectList(ReportSearchViewModel.PageSizes))"></select>
        </div>
    </div>
</form>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* ---------------- Sonuç tablosu ---------------- *@
@if (Model.Result is { } result)
{
    <form method="get" asp-action="DeletePreview" id="reportsForm">
        <div class="d-flex align-items-center gap-2 mb-2">
            <button type="submit" class="btn btn-danger btn-sm" id="bulkDeleteBtn" disabled>
                Seçilenleri sil (<span id="selectedCount">0</span>)
            </button>
            <span class="text-muted small ms-auto">Sayfa @result.Page &middot; bu sayfada @result.Items.Count kayıt</span>
        </div>

        <div class="table-responsive bg-white border rounded">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:2rem">
                            <input type="checkbox" class="form-check-input" id="selectAll" title="Sayfadakilerin tümünü seç" />
                        </th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Name)">Rapor adı @Model.SortIndicator(ReportSortField.Name)</a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Kind)">Tip @Model.SortIndicator(ReportSortField.Kind)</a></th>
                        <th>Klasör</th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Owner)">Sahip @Model.SortIndicator(ReportSortField.Owner)</a></th>
                        <th class="text-nowrap"><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.UpdatedAt)">Son değişiklik @Model.SortIndicator(ReportSortField.UpdatedAt)</a></th>
                        <th><a class="sort-link" asp-action="Index" asp-all-route-data="@Model.SortRouteValues(ReportSortField.Id)">ID @Model.SortIndicator(ReportSortField.Id)</a></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (result.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Kriterlere uyan rapor bulunamadı.</td>
                        </tr>
                    }
                    @foreach (var item in result.Items)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input row-check" name="selectedIds" value="@item.Id" />
                            </td>
                            <td>@item.Name</td>
                            <td><span class="badge text-bg-light border">@item.KindDisplayName</span></td>
                            <td class="small text-muted">@item.FolderPath</td>
                            <td>@item.Owner</td>
                            <td class="text-nowrap">@item.UpdatedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="small text-muted">@item.Id</td>
                            <td class="text-end">
                                <a class="btn btn-outline-danger btn-sm py-0" asp-action="DeletePreview" asp-route-selectedIds="@item.Id">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>

    <nav class="mt-3" aria-label="Sayfalama">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(result.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValues(page: result.Page - 1)">&lsaquo; Önceki</a>
            </li>
            <li class="page-item active"><span class="page-link">@result.Page</span></li>
            <li class="page-item @(result.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@Model.RouteValues(page: result.Page + 1)">Sonraki &rsaquo;</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
