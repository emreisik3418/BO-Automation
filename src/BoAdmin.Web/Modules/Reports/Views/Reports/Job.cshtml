@using BoAdmin.Web.Infrastructure
@model JobViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Subtitle"] = "İşlem sunucuda devam ediyor. Bu sayfa her saniye güncellenir; bitince sonuç kendiliğinden açılır.";
}

<div class="row">
    <div class="col-xxl-8 col-xl-10">
        <div class="card job-card" id="jobProgress"
             data-status-url="@Model.StatusUrl" data-result-url="@Model.ResultUrl" data-back-url="@Model.BackUrl">
            <div class="card-body">

                <div class="d-flex align-items-start gap-3 mb-3">
                    <span class="stat-icon tone-brand m-0 job-spinner" aria-hidden="true">@Icons.Get("activity")</span>
                    <div class="flex-grow-1 min-w-0">
                        <div class="job-step" data-job="step">Hazırlanıyor</div>
                        <div class="job-phase" data-job="phase">İşlem başlatılıyor...</div>
                    </div>
                    <span class="env-pill env-pill-@Model.Environment.Color">
                        <span class="env-dot bg-@Model.Environment.Color"></span>@Model.Environment.DisplayName
                    </span>
                </div>

                <div class="job-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-job="bar">
                    <div class="job-bar-fill" data-job="fill" style="width:0%"></div>
                </div>

                <div class="job-figures">
                    <div><span class="job-percent" data-job="percent">%0</span></div>
                    <div class="job-count" data-job="count"></div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-6 col-md-3">
                        <div class="summary-tile">
                            <div class="summary-label">Geçen süre</div>
                            <div class="summary-value" data-job="elapsed">00:00</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="summary-tile">
                            <div class="summary-label">Kalan süre</div>
                            <div class="summary-value" data-job="remaining">hesaplanıyor</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="summary-tile">
                            <div class="summary-label">Başarılı</div>
                            <div class="summary-value text-success" data-job="success">0</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="summary-tile">
                            <div class="summary-label">Başarısız</div>
                            <div class="summary-value" data-job="fail">0</div>
                        </div>
                    </div>
                </div>

                <div class="job-current mt-3" data-job="current-wrap" hidden>
                    <span class="text-muted">İşleniyor:</span> <strong data-job="current"></strong>
                </div>

                <div class="alert alert-danger mt-3 mb-0" data-job="error" hidden></div>

                <div class="mt-3 d-flex gap-2" data-job="actions" hidden>
                    <a class="btn btn-outline-secondary" href="@Model.BackUrl">Geri dön</a>
                </div>
            </div>
        </div>

        <p class="small text-muted mt-3">
            Sayfayı kapatsanız da işlem sunucuda devam eder. Sonuçları <a asp-action="History">İşlem Geçmişi</a>'nde görebilirsiniz.
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
