@model (string Title, IReadOnlyList<GroupListItemDto> Groups)

<div class="card">
    <div class="toolbar">
        <span class="toolbar-title">@Model.Title</span>
        <span class="toolbar-meta">@Model.Groups.Count</span>
    </div>
    @if (Model.Groups.Count == 0)
    {
        <div class="empty-state py-3"><div class="empty-text mb-0">Yok</div></div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var g in Model.Groups)
            {
                <li class="list-group-item">
                    <a class="text-decoration-none fw-semibold" asp-action="Detail" asp-route-id="@g.Id">@g.Name</a>
                    @if (g.Description is not null)
                    {
                        <div class="small text-muted text-truncate">@g.Description</div>
                    }
                </li>
            }
        </ul>
    }
</div>
