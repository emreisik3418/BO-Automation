@using BoAdmin.Web.Infrastructure
@{
    ViewData["Title"] = "Üyelik Raporu";
    ViewData["Subtitle"] = "Grupların kullanıcı ve alt grup üyeliklerini Excel olarak indirin.";
    var text = Context.Request.Query["text"].ToString();
}

<div class="row g-4">
    <div class="col-xxl-7 col-xl-8">
        <form method="post" asp-action="MembershipReport" class="card" data-busy-form>
            <div class="card-body">
                <label for="Text" class="form-label">Grup adı</label>
                <div class="input-icon mb-1">
                    @Icons.Get("search", 16)
                    <input type="text" class="form-control" id="Text" name="Text" value="@text" placeholder="Ad içerir... (boş: tüm gruplar)" autocomplete="off" />
                </div>
                <div class="form-text mb-3">
                    Adında bu metin geçen tüm gruplar rapora alınır (en fazla @PrincipalService.MaxReportGroups grup).
                    Tek bir grup için grup detay sayfasındaki butonu kullanabilirsiniz.
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="IncludeNested" value="true" id="IncludeNested" />
                    <label class="form-check-label" for="IncludeNested">Alt grupları da aç (iç içe üyelikler)</label>
                </div>

                <button type="submit" class="btn btn-primary" data-busy-text="Başlatılıyor...">@Icons.Get("sheet", 16) Raporu hazırla</button>
            </div>
        </form>
    </div>

    <div class="col-xxl-5 col-xl-4">
        <div class="card">
            <div class="card-header">Rapor içeriği</div>
            <div class="card-body">
                <ul class="small text-muted mb-0 ps-3">
                    <li>Her satır bir üyelik: grup, alt grup yolu, üye türü (Kullanıcı / Grup), üye adı, tam ad, e-posta, durum, son giriş.</li>
                    <li>"Alt grupları da aç" seçilirse alt grupların üyeleri de "Ana grup &gt; Alt grup" yoluyla listelenir.</li>
                    <li>Rapor arka planda hazırlanır; ilerleme ve kalan süre ekranda görünür.</li>
                    <li>Excel'de filtre ve dondurulmuş başlık satırı hazır gelir.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
